// =============================================================================
// Jenkinsfile — Plantilla para sincronizar documentación con Wiki.js (UMH)
// =============================================================================
//
// CÓMO USAR ESTA PLANTILLA:
// 1. Copia este fichero a la raíz de tu repositorio de documentación.
// 2. Asegúrate de que el repo tiene:
//    - Una carpeta 'docs/' con los ficheros .md
//    - Un fichero 'wikijs-sync.yml' con la configuración (base_path, etc.)
// 3. En Jenkins, crea un job de tipo "Multibranch Pipeline" apuntando a tu repo.
// 4. Configura las credenciales 'wikijs-token' en Jenkins (el token de la API de Wiki.js).
//
// REQUISITOS EN JENKINS:
// - Plugin "Docker Pipeline" instalado.
// - Credencial 'wikijs-token' de tipo "Secret text" con el token de Wiki.js.
// - El agente de Jenkins debe poder ejecutar Docker.
//
// VARIANTES:
// - Variante A (recomendada): Usar imagen Docker con la herramienta ya instalada.
//   Más rápido, no instala nada en cada ejecución. Requiere Container Registry.
// - Variante B: Instalar la herramienta con pip en cada ejecución.
//   No requiere registry, pero más lento. Es la que viene por defecto aquí.
//
// =============================================================================

pipeline {
    agent {
        docker {
            // ===============================================================
            // VARIANTE A: Imagen con la herramienta ya instalada (más rápida)
            // Descomenta esta línea y comenta la de python:3.12-slim
            // ===============================================================
            // image 'registry.umh.es/sipt/wikijs-sync:0.2.0'
            
            // ===============================================================
            // VARIANTE B: Imagen oficial de Python (instala en cada ejecución)
            // ===============================================================
            image 'python:3.12-slim'
            // -u root: para poder instalar git con apt-get
            args '-u root'
        }
    }

    // Evita que dos ejecuciones se pisen si hay varios push seguidos
    options {
        disableConcurrentBuilds()
    }

    environment {
        // =====================================================================
        // CONFIGURAR ESTOS VALORES PARA TU ENTORNO
        // =====================================================================
        
        // URL de la wiki de la UMH (sin barra final)
        // ⚠️ IMPORTANTE: Usar HTTPS para que el token no viaje en claro
        WIKI_URL = 'https://wiki.umh.es'
        
        // Token de la API de Wiki.js (guardado en Jenkins Credentials)
        WIKI_TOKEN = credentials('wikijs-token')
        
        // URL del repositorio de la herramienta en GitLab (para variante B)
        // Se fija la versión con @v0.2.0 para evitar cambios inesperados
        HERRAMIENTA_URL = 'https://gitlab.umh.es/sipt/wikijs-sync.git@v0.2.0'
    }

    stages {
        // Etapa 1: Instalar la herramienta (solo variante B)
        // Si usas variante A con imagen propia, comenta este stage completo
        stage('Instalar herramienta') {
            steps {
                sh '''
                    apt-get update && apt-get install -y --no-install-recommends git
                    pip install --quiet "git+${HERRAMIENTA_URL}"
                '''
            }
        }

        // Etapa 2: Dry-run en ramas (para ver qué haría sin tocar la wiki)
        stage('Comprobar (ramas)') {
            when { not { branch 'master' } }
            steps {
                sh 'python -m wikijs_sync --config wikijs-sync.yml --dry-run --prune'
            }
        }

        // Etapa 3: Sincronizar de verdad (solo en master)
        stage('Sincronizar con Wiki.js') {
            when { branch 'master' }
            steps {
                sh 'python -m wikijs_sync --config wikijs-sync.yml --prune'
            }
        }
    }

    post {
        success {
            echo 'Sincronización completada correctamente.'
        }
        failure {
            echo 'Error en la sincronización. Revisa el log de la consola.'
        }
    }
}

// =============================================================================
// NOTAS ADICIONALES
// =============================================================================
//
// OPCIONES DE LA HERRAMIENTA:
//   --dry-run   Simula la sincronización sin tocar la wiki (para probar)
//   --prune     Borra de la wiki las páginas que ya no existen en el repo
//
// SEGURIDAD:
// - Usar HTTPS en WIKI_URL para que el token no viaje en claro por la red.
// - El token se guarda en Jenkins Credentials, nunca en el Jenkinsfile.
// - Fijar la versión de la herramienta (@v0.2.0) para evitar sorpresas.
//
// TRIGGER AUTOMÁTICO (webhook):
// En GitLab, configura un webhook que apunte a Jenkins para que se ejecute
// automáticamente con cada push:
//   GitLab → Settings → Webhooks → URL: http://jenkins-umh/job/NOMBRE-JOB/build
//
// VARIOS DEPARTAMENTOS:
// Cada departamento tiene su propio repo con su wikijs-sync.yml.
// Cada repo apunta a un base_path diferente en la wiki (ej: conocimiento/sistemas/redes).
// Se crea un job de Jenkins por departamento, o un job con parámetros.
//
// REPO PRIVADO:
// Si el repo de la herramienta es privado, la línea 'pip install git+...' fallará.
// Soluciones:
// - Usar la variante A con imagen Docker que ya tiene la herramienta
// - Configurar un deploy token en GitLab y usarlo en la URL
//
// =============================================================================
